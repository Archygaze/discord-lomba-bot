# ==========================================
# DISCORD BOT CONFIGURATION
# ==========================================
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# The Discord channel ID where notifications will be posted (Right click channel -> Copy Channel ID)
DISCORD_CHANNEL_ID=123456789012345678

# Role to mention:
# - Put a numerical Role ID (e.g. 987654321098765432)
# - Or write "everyone" to ping @everyone
# - Or write "here" to ping @here
# - Or leave blank to send without mentioning any role
DISCORD_PING_ROLE_ID=everyone

# ==========================================
# SCHEDULE & MONITORING SETTINGS
# ==========================================
# How often to check for new posts (in minutes)
CHECK_INTERVAL_MINUTES=30

# Comma-separated list of Instagram usernames to monitor (without @)
TARGET_ACCOUNTS=hackathon_id,infolomba,lombanasional,eventkampus,dicoding

# Enable keyword filtering (true / false)
# If true, only posts matching the keywords below will be posted
ENABLE_KEYWORD_FILTER=true

# Keywords used to filter competition and hackathon posts
KEYWORDS=hackathon,lomba,kompetisi,competition,coding,datathon,ideathon,ctf,capture the flag,ui/ux,web development,software engineering,cyber security,open registration,registrasi dibuka,hadiah jutaan,total hadiah

# ==========================================
# INSTAGRAM FETCHING METHOD
# ==========================================
# OPTION 1: RSS Bridge / RSSHub (Recommended & most stable, no IG block!)
# If you have an RSSHub instance (or use RSS.app):
# Example: https://rsshub.app/instagram/user/{username}
RSS_FEED_TEMPLATE=

# OPTION 2: Instaloader Credentials (Optional)
# If left blank, it will attempt anonymous scraping, which may be rate-limited by Instagram.
IG_USERNAME=
IG_PASSWORD=

# OPTION 3: Mock / Demo Mode
# Set to 'true' if you want to test Discord pings and embeds immediately with sample hackathon data
ENABLE_MOCK_DATA=false

